# Runs the server from a source checkout; ExecStartPre syncs .venv to uv.lock on every start,
# so updating is `git pull` + `systemctl restart`. The server runs from .venv directly rather
# than via `uv run`: a snap-packaged uv moves its children out of this unit's cgroup, which
# hides their output from `journalctl -u` and leaves them running after `systemctl stop`.
# Replace the placeholders on install (see the README).
[Unit]
Description=GARM MCP server
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/path/to/garm-mcp
ExecStartPre=/path/to/uv sync --frozen
ExecStart=/path/to/garm-mcp/.venv/bin/python -m garm_mcp --config /etc/garm-mcp/config.json
# Also covers a bind address that does not exist yet at boot, such as an LXD bridge.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
